# Copy to .env and fill in. Never commit the real .env.

# --- ElevenLabs ---
# Needs ElevenAgents read+write permission; a TTS/STT-only key is refused.
PAID_ELEVENLABS_API_KEY=""
# Public https URL of el_tools.py. start.ps1 fills this in from the tunnel;
# el_setup.py points the tools, LLM proxy and webhook at it.
EL_TOOLS_BASE_URL="https://your-tunnel.example"
# Shared bearer token ElevenLabs sends to the tools. Any long random string.
EL_TOOL_TOKEN=""

# --- Model ---
# "custom" = the OpenAI-compatible endpoint below, through el_tools' /llm proxy.
# Or an ElevenLabs-hosted model id, e.g. claude-haiku-5-5.
EL_LLM="custom"
EL_LLM_FALLBACKS="claude-haiku-5-5,gemini-3.5-flash"
PUBLICA_LLM_ENDPOINT=""
PUBLICA_LLM_MODEL=""
PUBLICA_LLM_API_KEY=""

# --- Telephony (optional) ---
# An imported Twilio/SIP number id. Empty = the cardholder answers in the browser.
ELEVENLABS_PHONE_NUMBER_ID=""
# Ring this number instead of the customer's fixture number.
EL_DEMO_PHONE=""
# Live hand-over target for transfer_to_number. Left at the placeholder, the
# agent promises a call back instead of transferring.
FRAUD_DESK_NUMBER="+2348000000000"

# --- Officer report on WhatsApp (optional, Meta Cloud API) ---
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_VERSION="v23.0"
OFFICER_PHONE=""

# --- Bank identity and limits ---
BANK_NAME="Sora Bank"
AGENT_DISPLAY_NAME="Ada"
MAX_CALL_SECONDS="300"
MAX_VERIFICATION_ATTEMPTS="3"

# --- Optional voice overrides (defaults chosen from the Voice Library) ---
# EL_TTS_MODEL="eleven_v3_conversational"
# EL_VOICE_EN="OYTbf65OHHFELVut7v2H"
# EL_VOICE_AR="XTa3iQyMA6f1qrI4F6kZ"
